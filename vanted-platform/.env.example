# Copy to .env for local development.
VANTED_ENV=local
VANTED_LOCAL_MODE=true
VANTED_TEST_MODE=false
VANTED_PRODUCTION_FEATURES=false
VANTED_KUBERNETES_ENABLED=false
VANTED_DEBUG_FEATURES=false
VANTED_OBSERVABILITY_ENABLED=false
VANTED_REDIS_ENABLED=true
VANTED_RABBITMQ_ENABLED=true
VANTED_EXTERNAL_INTEGRATIONS_ENABLED=false
VANTED_PAYMENT_MODE=mock
VANTED_HTTP_PORT=8080
VANTED_HTTPS_PORT=8443

# Local development credentials only. Never reuse these in test or production.
MYSQL_DATABASE=vanted
MYSQL_USER=vanted
MYSQL_PASSWORD=test1234
MYSQL_ROOT_PASSWORD=test1234
RABBITMQ_USER=vanted
RABBITMQ_PASSWORD=test1234
REDIS_PASSWORD=test1234
VANTED_JWT_SECRET=test1234-test1234-test1234-test1234
