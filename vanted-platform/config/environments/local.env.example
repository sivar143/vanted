# Local development mode: enabled by default.
VANTED_ENV=local
VANTED_LOCAL_MODE=true
VANTED_KUBERNETES_ENABLED=false
VANTED_PRODUCTION_FEATURES=false
VANTED_TEST_MODE=false

# Local infrastructure is provided by Docker Compose.
MYSQL_DATABASE=vanted
MYSQL_USER=vanted
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-root-password
RABBITMQ_USER=vanted
RABBITMQ_PASSWORD=change-me
REDIS_PASSWORD=change-me
VANTED_JWT_SECRET=replace-with-a-long-random-local-secret
