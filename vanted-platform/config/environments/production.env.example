# Production deployment settings.
VANTED_ENV=production
VANTED_LOCAL_MODE=false
VANTED_TEST_MODE=false
VANTED_PRODUCTION_FEATURES=true
VANTED_KUBERNETES_ENABLED=true
VANTED_DEBUG_FEATURES=false
