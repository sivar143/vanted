{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "projects": {
    "vanted-frontend": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "prefix": "vanted",
      "architect": {
        "build": {"builder": "@angular/build:application", "options": {"browser": "src/main.ts", "tsConfig": "tsconfig.app.json", "index": "src/index.html", "styles": ["src/styles.css"]}},
        "serve": {"builder": "@angular/build:dev-server", "configurations": {"production": {"buildTarget": "vanted-frontend:build:production"}, "development": {"buildTarget": "vanted-frontend:build:development"}}, "defaultConfiguration": "development"}
      }
    }
  }
}
